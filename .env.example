NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://numwan.net

# Server-only Supabase key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Payment provider
PAYMENT_PROVIDER=edfapay

# EdfaPay Hosted Checkout. Keep the API key server-only.
EDFAPAY_API_KEY=YOUR_EDFAPAY_API_KEY
# production => https://app-api.edfapay.com
# sandbox    => https://demo-api.edfapay.com
EDFAPAY_ENV=production
# Optional override if EdfaPay gives you a dedicated base URL.
EDFAPAY_API_BASE_URL=
